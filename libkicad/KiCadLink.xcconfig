// libkicad is a static archive, so its KiCad runtime dependencies must be present on the final
// executable's link line. Keep that implementation detail here instead of duplicating it across
// the app, CLI, workers, and test targets.
#include "BuildPaths.xcconfig"

OTHER_LDFLAGS = $(inherited) \
    -Wl,-undefined,dynamic_lookup \
    -Wl,-needed-lwx_osx_cocoau_gl-3.2 \
    -Wl,-needed-lwx_osx_cocoau_aui-3.2 \
    -Wl,-needed-lwx_osx_cocoau_html-3.2 \
    -Wl,-needed-lwx_osx_cocoau_core-3.2 \
    -Wl,-needed-lwx_baseu_net-3.2 \
    -Wl,-needed-lwx_baseu-3.2 \
    -Wl,-needed-lwx_osx_cocoau_propgrid-3.2 \
    -Wl,-needed-lwx_baseu_xml-3.2 \
    -Wl,-needed-lwx_osx_cocoau_stc-3.2 \
    -Wl,-needed-lwx_osx_cocoau_richtext-3.2 \
    -Wl,-needed-lwx_osx_cocoau_webview-3.2 \
    $(KICAD_BUILD_ROOT)/pcbnew/CMakeFiles/pcbnew_kiface_objects.dir/api/api_handler_pcb.cpp.o \
    $(KICAD_BUILD_ROOT)/pcbnew/CMakeFiles/pcbnew_kiface_objects.dir/api/api_handler_board.cpp.o \
    $(KICAD_BUILD_ROOT)/pcbnew/CMakeFiles/pcbnew_kiface_objects.dir/api/headless_pcb_context.cpp.o \
    $(KICAD_BUILD_ROOT)/pcbnew/CMakeFiles/pcbnew_kiface_objects.dir/api/pcb_context.cpp.o \
    $(KICAD_BUILD_ROOT)/common/libpcbcommon.a \
    $(KICAD_BUILD_ROOT)/libs/kiplatform/libkiplatform.a \
    $(KICAD_BUILD_ROOT)/common/libcommon.a \
    $(KICAD_BUILD_ROOT)/libs/core/libcore.a \
    $(KICAD_BUILD_ROOT)/thirdparty/planegcs/libplanegcs.a \
    $(KICAD_BUILD_ROOT)/libs/kimath/libkimath.a \
    $(KICAD_BUILD_ROOT)/thirdparty/clipper2/libclipper2.a \
    $(KICAD_BUILD_ROOT)/thirdparty/fmt/libfmt.a \
    $(KICAD_FRAMEWORK_ROOT)/libkigal.dylib \
    $(KICAD_FRAMEWORK_ROOT)/libkicommon.dylib \
    $(KICAD_FRAMEWORK_ROOT)/libkiapi.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKBinL.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKBin.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKBinTObj.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKBinXCAF.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKBool.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKBO.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKDESTEP.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKDESTL.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKDEIGES.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKDEGLTF.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKDEVRML.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKDEPLY.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKXCAF.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKCAF.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKCDF.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKFeat.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKFillet.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKLCAF.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKBRep.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKG2d.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKG3d.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKGeomBase.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKGeomAlgo.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKHLR.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKMesh.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKOffset.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKTopAlgo.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKPrim.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKRWMesh.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKService.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKShHealing.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKTObj.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKV3d.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKXMesh.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKXmlL.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKXml.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKXmlTObj.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKXmlXCAF.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKXSBase.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKMath.dylib \
    $(HOMEBREW_PREFIX)/lib/libTKernel.dylib

LD_RUNPATH_SEARCH_PATHS = $(inherited) $(KICAD_FRAMEWORK_ROOT) $(HOMEBREW_PREFIX)/lib
