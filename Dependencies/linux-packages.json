{
  "schema": 1,
  "components": {
    "build": {
      "description": "CMake build tools",
      "apt": ["build-essential", "cmake", "ninja-build", "pkg-config", "git"],
      "dnf": ["gcc-c++", "cmake", "ninja-build", "pkgconf-pkg-config", "git"],
      "pacman": ["base-devel", "cmake", "ninja", "pkgconf", "git"],
      "zypper": ["gcc-c++", "cmake", "ninja", "pkg-config", "git"]
    },
    "kiems": {
      "description": "KiEMS CLI and libkiems",
      "apt": {
        "packages": ["libgeos-dev", "gnuplot-nox", "nlohmann-json3-dev"],
        "notes": ["Install Matplot++ from a package if your release provides one, or build it separately and set Matplot++_DIR to its CMake package directory."]
      },
      "dnf": {
        "packages": ["geos-devel", "gnuplot", "nlohmann-json-devel"],
        "notes": ["Install Matplot++ from an enabled repository if available, or build it separately and set Matplot++_DIR to its CMake package directory."]
      },
      "pacman": {
        "packages": ["geos", "gnuplot", "nlohmann-json"],
        "notes": ["Matplot++ is not in Arch's official repositories; install an AUR package such as matplotplusplus-git, or build it separately and set Matplot++_DIR to its CMake package directory."]
      },
      "zypper": {
        "packages": ["geos-devel", "gnuplot", "nlohmann_json-devel"],
        "notes": ["Install Matplot++ from an enabled repository if available, or build it separately and set Matplot++_DIR to its CMake package directory."]
      }
    },
    "copper": {
